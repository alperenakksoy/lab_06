FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY shared/     ./shared/
COPY sensor.proto .
COPY service_grpc.py .

# Generate gRPC stubs from sensor.proto at build time
RUN python -m grpc_tools.protoc \
      -I. \
      --python_out=. \
      --grpc_python_out=. \
      sensor.proto

EXPOSE 50051

CMD ["python", "service_grpc.py"]
